# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Stripe (Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (resend.com → API Keys) — used to send booking/enquiry emails
RESEND_API_KEY=re_...
FROM_EMAIL=Hiltonia <bookings@yourdomain.com>
ADMIN_NOTIFY_EMAIL=hello@hiltonia.lk

# The deployed frontend origin — used for CORS and Stripe redirect URLs
FRONTEND_URL=http://localhost:5500

PORT=4000
